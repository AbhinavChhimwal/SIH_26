# ==============================================================================
# SENTIX ENVIRONMENT CONFIGURATION & REAL API KEYS
# ==============================================================================
# To switch any connector from synthetic simulation to genuine live platform APIs,
# provide your developer credentials below. The platform connector will automatically
# switch from "simulating" to "connected" and fetch genuine live posts.

# ------------------------------------------------------------------------------
# 1. X (formerly Twitter) API v2 (Filtered Stream / Recent Search)
# Get from: https://developer.x.com/en/portal/dashboard
# ------------------------------------------------------------------------------
TWITTER_BEARER_TOKEN="your_x_twitter_bearer_token_here"
TWITTER_API_KEY="your_x_api_key_here"
TWITTER_API_SECRET="your_x_api_secret_here"

# ------------------------------------------------------------------------------
# 2. Telegram Bot & MTProto API
# Get from: https://core.telegram.org/api/obtaining_api_id or @BotFather
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_API_ID="your_telegram_api_id_here"
TELEGRAM_API_HASH="your_telegram_api_hash_here"
TELEGRAM_TARGET_CHANNELS="@durov,@telegram,@techcrunch"

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 (Comments & Video Discussions)
# Get from: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY="your_google_cloud_youtube_api_key_here"

# ------------------------------------------------------------------------------
# 4. Reddit API (Streaming & Search)
# Get from: https://www.reddit.com/prefs/apps
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID="your_reddit_client_id_here"
REDDIT_CLIENT_SECRET="your_reddit_client_secret_here"
REDDIT_USER_AGENT="SentixIntelligence/1.0.0"

# ------------------------------------------------------------------------------
# 5. Meta Graph API (Instagram & Facebook Public Pages)
# Get from: https://developers.facebook.com/apps/
# ------------------------------------------------------------------------------
META_ACCESS_TOKEN="your_meta_graph_api_long_lived_token_here"
META_PAGE_ID="your_facebook_page_id_here"
INSTAGRAM_ACCOUNT_ID="your_instagram_business_account_id_here"

# ------------------------------------------------------------------------------
# Ingestion Mode
# Values: 'hybrid' | 'live_strict' | 'simulation_only'
# ------------------------------------------------------------------------------
INGESTION_MODE="hybrid"
